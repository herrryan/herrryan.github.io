---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="inline-block my-1 mr-2">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group inline-flex items-center gap-1.5 rounded-md font-medium transition-all shadow-2xs hover:shadow-xs cursor-pointer",
      "bg-muted text-foreground/90 hover:bg-accent hover:text-accent-foreground",
      "focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-hidden",
      { "text-xs px-2.5 py-1": size === "sm" },
      { "text-sm px-3 py-1.5": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-60 group-hover:opacity-100 transition-opacity stroke-current",
        { "size-3.5": size === "sm" },
        { "size-4": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
    {
      typeof count === "number" && (
        <span class="ms-1 rounded-full bg-background/60 px-1.5 py-0.5 text-[10px] text-muted-foreground group-hover:bg-accent-foreground/20 group-hover:text-accent-foreground">
          {count}
        </span>
      )
    }
  </a>
</li>

