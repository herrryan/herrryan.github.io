---
import config from "@/config";

const { site, socials } = config;
const emailSocial = socials.find(s => s.name === "mail");
const email = emailSocial ? emailSocial.url.replace(/^mailto:/, "") : "guofei89@gmail.com";

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const socialItems = await Promise.all(
  socials
    .filter(s => s.name !== "mail")
    .map(async ({ name, url, linkTitle }) => {
      const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
      const Icon = mod?.default;
      const title =
        linkTitle ??
        `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`;
      return { url, title, Icon };
    })
);
---

<!-- Left Floating Sidebar (Rotated Vertical Email) -->
<aside
  class="hidden fixed left-6 xl:left-8 2xl:left-12 bottom-0 xl:flex flex-col w-6 h-64 items-center justify-between z-30 select-none"
  aria-label="Direct Email link"
>
  <div class="-rotate-90 text-xs tracking-widest text-muted-foreground hover:text-accent transition-colors font-mono mb-16">
    <a
      href={`mailto:${email}`}
      class="hover:text-accent hover:underline focus-visible:outline-accent underline-offset-4"
    >
      {email}
    </a>
  </div>
  <div class="w-20 h-px bg-border rotate-90 origin-bottom mt-auto"></div>
</aside>

<!-- Right Floating Sidebar (Vertical Social Icons) -->
<aside
  class="hidden fixed right-6 xl:right-8 2xl:right-12 bottom-0 xl:flex flex-col w-6 h-64 items-center justify-between z-30 select-none"
  aria-label="Social media profiles"
>
  <div class="flex flex-col space-y-4 items-center">
    {
      socialItems.map(({ url, title, Icon }) =>
        Icon ? (
          <a
            href={url}
            title={title}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-accent hover:-translate-y-1 transition-all p-1"
          >
            <Icon class="size-5 fill-transparent stroke-current stroke-2" />
            <span class="sr-only">{title}</span>
          </a>
        ) : null
      )
    }
  </div>
  <div class="w-20 h-px bg-border rotate-90 origin-bottom mt-auto"></div>
</aside>
